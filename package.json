{
  "name": "outsider-driver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run runtime:prepare && vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "content:check": "vitest run src/content/validation/ProductionContentValidator.test.ts --reporter=verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run fixture:inochi && playwright test",
    "build": "npm run runtime:prepare && npm run typecheck && vite build",
    "check": "npm run lint && npm run content:check && npm run test && npm run build",
    "runtime:prepare": "node scripts/prepare-inochi-runtime.mjs",
    "fixture:inochi": "node scripts/prepare-inochi-fixture.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.28.0",
    "inkjs": "2.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
